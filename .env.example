# ==============================================================================
# ResuArchitect AI — Environment Configuration (Optional)
# ==============================================================================
# The platform works 100% offline out-of-the-box using its built-in
# Deterministic Scorer and Offline Heuristic Tailoring Engine.
#
# If you wish to connect an external LLM for cloud AI tailoring,
# copy this file to .env.local:
#   cp .env.example .env.local
# and configure ONE of the following options:

# ------------------------------------------------------------------------------
# Option A: Featherless AI (Open Source Models: Llama 3.1, Mistral, Qwen)
# ------------------------------------------------------------------------------
FEATHERLESS_API_KEY="your-featherless-api-key"
# FEATHERLESS_BASE_URL="https://api.featherless.ai/v1"
# FEATHERLESS_MODEL="meta-llama/Meta-Llama-3.1-8B-Instruct"

# ------------------------------------------------------------------------------
# Option B: OpenAI / OpenRouter (Commercial Models)
# ------------------------------------------------------------------------------
# OPENAI_API_KEY="your-openai-or-openrouter-api-key"
# OPENAI_BASE_URL="https://api.openai.com/v1"
# OPENAI_MODEL="gpt-4o-mini"
